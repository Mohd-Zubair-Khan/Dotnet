# Ignore Visual Studio temporary files, build results, and files generated by popular add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# Visual Studio working folders
.vs/

# Backup & cache
*.tmp
*.bak
*.swp
*.cache

# Packages (NuGet)
*.nupkg
packages/
*.snupkg

# Build artifacts
*.dll
*.exe
*.pdb
*.appx
*.msi
*.zip

# Rider & JetBrains
.idea/
*.sln.iml

# DotCover
.idea/.idea/
.idea/.dotCover

# Test results
TestResults/
*.trx

# Publish output
publish/
*.Publish.xml

# Ignore generated files
Generated\ Files/

# Others
_ReSharper*/
*_UpgradeReport_Files/
