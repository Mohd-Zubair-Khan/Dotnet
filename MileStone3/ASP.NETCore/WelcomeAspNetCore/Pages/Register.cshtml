@page
@model RegisterModel
@{
    Layout = "_Layout";
}
<h2>User Registration</h2>
<form method="post">
    <label>Username:</label> <input type="text" asp-for="UserName" />
    <label>Email:</label> <input type="email" asp-for="Email" />
    <label>Password:</label> <input type="password" asp-for="Password" />
    <button type="submit">Register</button>
</form>
